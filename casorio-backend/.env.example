# Porta do servidor HTTP (o Render define automaticamente a variável PORT)
PORT=3333
NODE_ENV=development

# URL(s) do frontend autorizadas no CORS (separe múltiplas origens por vírgula)
FRONTEND_URL=http://localhost:5173

# URL pública do backend (necessária para receber o Webhook oficial do Mercado Pago)
BACKEND_PUBLIC_URL=http://localhost:3333

# Credenciais do Supabase (NUNCA exponha a SERVICE_ROLE_KEY no frontend!)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta

# Credenciais do Mercado Pago
# - MP_PUBLIC_KEY: chave pública (também usada no frontend em VITE_MERCADO_PAGO_PUBLIC_KEY)
# - MP_ACCESS_TOKEN: chave privada (NUNCA exponha o ACCESS_TOKEN no frontend ou no Git!)
MP_PUBLIC_KEY=APP_USR-sua-public-key-aqui
MP_ACCESS_TOKEN=APP_USR-seu-access-token-secreto

# Chave secreta de assinatura do Webhook do Mercado Pago (opcional, mas recomendada em produção)
MP_WEBHOOK_SECRET=
