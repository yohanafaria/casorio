# Ativa os dados mockados no frontend (substituir por false quando o backend estiver pronto)
VITE_USE_MOCK_API=true

# URL base da API do backend (ex: https://api.danieleyohana.com.br)
VITE_API_BASE_URL=http://localhost:3333

# Public Key do Mercado Pago para inicialização futura do Payment Brick no navegador
